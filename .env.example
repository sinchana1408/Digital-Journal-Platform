# LumaJournal Root & Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumajournal?schema=public"

# Authentication
JWT_SECRET="lumajournal_super_secure_jwt_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# Client Web Application URL (for CORS and Socket.IO)
CLIENT_URL="http://localhost:5173"

# Optional Cloud/Media Storage settings (defaults to local storage)
UPLOAD_DIR="./uploads"
